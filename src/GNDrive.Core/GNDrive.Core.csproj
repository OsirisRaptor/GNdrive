<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GNDrive.Core</AssemblyName>
    <RootNamespace>GNDrive</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(UseKspStubs)' == 'true' ">
    <DefineConstants>$(DefineConstants);KSP_STUBS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition=" '$(UseKspStubs)' != 'true' ">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPDllDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KSPUtil">
      <HintPath>$(KSPDllDir)/KSPUtil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPDllDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KSPDllDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(KSPDllDir)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(KSPDllDir)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition=" '$(UseKspStubs)' == 'true' ">
    <Compile Include="../Stubs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PartModules/**/*.cs" />
    <Compile Include="Properties/**/*.cs" />
    <Compile Include="Utils/**/*.cs" />
  </ItemGroup>

  <Target Name="CopyToGameData" AfterTargets="Build">
    <PropertyGroup>
      <GameDataDir>$(MSBuildProjectDirectory)/../../GameData/GNDrive/Plugins</GameDataDir>
    </PropertyGroup>
    <MakeDir Directories="$(GameDataDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GameDataDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb"
          DestinationFolder="$(GameDataDir)"
          Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).xml"
          DestinationFolder="$(GameDataDir)"
          Condition="Exists('$(OutputPath)$(AssemblyName).xml')" />
  </Target>
</Project>
